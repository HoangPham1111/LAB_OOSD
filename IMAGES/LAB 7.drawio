        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor NguoiLap as Người lập quyết định\n    participant UI as ManHinhKhenThuong\n    participant S as KhenThuongService\n    participant R as NhanSuRepository\n    database DB as CSDL\n    actor GD as Giám đốc\n    actor KT as Kế toán\n    participant PS as PhieuChiService\n\n    NguoiLap-&gt;&gt;UI: Nhập đối tượng, lý do, số tiền thưởng\n    UI-&gt;&gt;S: lapQuyetDinhKhenThuong(data)\n    activate S\n\n    S-&gt;&gt;S: kiemTraDuLieu(data)\n\n    alt Dữ liệu không hợp lệ\n        S--&gt;&gt;UI: Thông báo lỗi cần bổ sung\n        UI--&gt;&gt;NguoiLap: Yêu cầu chỉnh sửa dữ liệu\n\n    else Dữ liệu hợp lệ\n\n        alt Khen thưởng cá nhân\n            S-&gt;&gt;R: kiemTraNhanVien(maNhanVien)\n        else Khen thưởng tập thể\n            S-&gt;&gt;R: kiemTraPhongBan(maPhongBan)\n        end\n\n        R-&gt;&gt;DB: Truy vấn đối tượng\n        DB--&gt;&gt;R: Trả thông tin đối tượng\n        R--&gt;&gt;S: Kết quả kiểm tra\n\n        alt Đối tượng không hợp lệ\n            S--&gt;&gt;UI: Thông báo đối tượng không tồn tại\n            UI--&gt;&gt;NguoiLap: Yêu cầu kiểm tra lại đối tượng\n\n        else Đối tượng hợp lệ\n            S-&gt;&gt;R: luuQuyetDinh(data, ChoKy)\n            R-&gt;&gt;DB: INSERT QuyetDinhKhenThuong\n            DB--&gt;&gt;R: Trả mã quyết định\n            R--&gt;&gt;S: Xác nhận lưu thành công\n            S--&gt;&gt;UI: Hiển thị quyết định chờ ký\n            UI--&gt;&gt;NguoiLap: Thông báo lập quyết định thành công\n\n            GD-&gt;&gt;UI: Xem và ký quyết định\n            UI-&gt;&gt;S: xacNhanKyDuyet(maQD)\n            S-&gt;&gt;R: capNhatTrangThai(maQD, DaKy)\n            R-&gt;&gt;DB: UPDATE trạng thái quyết định\n            DB--&gt;&gt;R: Kết quả cập nhật\n            R--&gt;&gt;S: Xác nhận cập nhật\n            S--&gt;&gt;UI: Thông báo quyết định đã được ký\n\n            opt Thực hiện chi tiền khen thưởng\n                KT-&gt;&gt;UI: Yêu cầu lập phiếu chi\n                UI-&gt;&gt;PS: lapPhieuChi(maQD)\n                PS-&gt;&gt;R: luuPhieuChi(maQD, soTien)\n                R-&gt;&gt;DB: INSERT PhieuChiKhenThuong\n                DB--&gt;&gt;R: Xác nhận lưu phiếu chi\n                R--&gt;&gt;PS: Trả thông tin phiếu chi\n                PS--&gt;&gt;UI: Thông báo lập phiếu chi thành công\n                UI--&gt;&gt;KT: Hiển thị phiếu chi\n            end\n        end\n    end\n\n    deactivate S&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="e3M2--7nwMTz5ElnNpTr-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Người lập quyết định" mermaidId="n:NguoiLap" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Người lập quyết định" id="e3M2--7nwMTz5ElnNpTr-2">
