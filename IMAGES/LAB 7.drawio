        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass PhongBan {\n  +MaPhongBan: String\n  +TenPhongBan: String\n  +LoaiDonVi: String\n}\n\nclass NhanVien {\n  +MaNhanVien: String\n  +HoTen: String\n  +NgayTiepNhan: Date\n  +TrangThaiNhanVien: String\n}\n\nclass QuyetDinhTuyenDung {\n  +MaQDTuyenDung: String\n  +NgayKy: Date\n  +ThoiGianThuViec: String\n  +LuongThuViec: Decimal\n  +DieuKhoan: String\n}\n\nclass HopDongLaoDong {\n  +MaHopDong: String\n  +LoaiHopDong: String\n  +NgayKy: Date\n  +NgayBatDau: Date\n  +NgayKetThuc: Date\n}\n\nclass QuyetDinhChucVu {\n  +MaQDChucVu: String\n  +TenChucVu: String\n  +PhuCapChucVu: Decimal\n  +NgayHieuLuc: Date\n}\n\nclass QuyetDinhLuong {\n  +MaQDLuong: String\n  +LuongCoBan: Decimal\n  +PhuCapLuong: Decimal\n  +PhuCapDocHai: Decimal\n  +NgayHieuLuc: Date\n}\n\nclass HoSoBaoHiem {\n  +MaHoSoBaoHiem: String\n  +LoaiBaoHiem: String\n  +MucDong: Decimal\n  +TrangThai: String\n}\n\nclass KeHoachPhanCong {\n  +MaKeHoach: String\n  +TuanBatDau: Date\n  +TuanKetThuc: Date\n}\n\nclass PhanCongCa {\n  +MaPhanCong: String\n  +NgayLam: Date\n  +CaLamViec: String\n  +SoGioDuKien: Decimal\n}\n\nclass BangChamCong {\n  +MaBangChamCong: String\n  +Thang: Integer\n  +Nam: Integer\n}\n\nclass ChiTietChamCong {\n  +MaCTChamCong: String\n  +Ngay: Date\n  +SoGioCong: Decimal\n  +TrangThaiCong: String\n}\n\nclass PhieuPhuTroi {\n  +SoPhieuPhuTroi: String\n  +NgayPhuTroi: Date\n  +HinhThucPhuTroi: String\n}\n\nclass ChiTietPhuTroi {\n  +MaCTPhuTroi: String\n  +SoGioPhuTroi: Decimal\n  +HeSoTinhGio: Decimal\n}\n\nclass BangLuong {\n  +MaBangLuong: String\n  +Thang: Integer\n  +Nam: Integer\n  +TrangThai: String\n}\n\nclass ChiTietBangLuong {\n  +MaCTBangLuong: String\n  +TongThuNhap: Decimal\n  +KhauTruBHYT: Decimal\n  +KhauTruBHXH: Decimal\n  +TienPhat: Decimal\n  +ThucLinh: Decimal\n}\n\nclass QuyetDinhKhenThuong {\n  +MaQDKhenThuong: String\n  +LoaiDoiTuongApDung: String\n  +SoTienKhenThuong: Decimal\n  +NgayKy: Date\n}\n\nclass PhieuChiKhenThuong {\n  +MaPhieuChi: String\n  +NgayChi: Date\n  +SoTienChi: Decimal\n  +TrangThai: String\n}\n\nclass QuyetDinhKyLuat {\n  +MaQDKyLuat: String\n  +SoTienPhat: Decimal\n  +HinhThucXuLy: String\n  +NgayKy: Date\n}\n\nclass PhieuThuNopPhat {\n  +MaPhieuThu: String\n  +NgayThu: Date\n  +SoTienThu: Decimal\n}\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien : quan ly\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung : nhu cau tuyen\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung : co quyet dinh\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong : ky hop dong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu : lich su chuc vu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong : lich su luong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoBaoHiem : co ho so\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong : lap ke hoach\nKeHoachPhanCong \&quot;1\&quot; *-- \&quot;1..*\&quot; PhanCongCa : gom chi tiet\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongCa : duoc phan cong\n\nBangChamCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietChamCong : gom chi tiet\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong : duoc cham cong\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi : gom chi tiet\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi : tham gia\n\nBangLuong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietBangLuong : gom chi tiet\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong : nhan luong\nQuyetDinhLuong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong : ap dung\nQuyetDinhChucVu \&quot;0..1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong : phu cap chuc vu\n\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiKhenThuong : chung tu chi\nQuyetDinhKhenThuong \&quot;0..*\&quot; -- \&quot;0..*\&quot; NhanVien : ca nhan duoc thuong\nQuyetDinhKhenThuong \&quot;0..*\&quot; -- \&quot;0..*\&quot; PhongBan : tap the duoc thuong\n\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuNopPhat : chung tu thu\nQuyetDinhKyLuat \&quot;0..*\&quot; -- \&quot;0..*\&quot; NhanVien : ca nhan bi xu ly\nQuyetDinhKyLuat \&quot;0..*\&quot; -- \&quot;0..*\&quot; PhongBan : tap the bi xu ly\nQuyetDinhKyLuat \&quot;0..*\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong : tru luong neu co&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="5BLzLl9VFSdyBinEPUKH-1">
