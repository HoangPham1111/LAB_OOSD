        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart LR\n    subgraph P1[\&quot;1. LẬP HỢP ĐỒNG\&quot;]\n        direction TB\n        A([Bắt đầu])\n        B[\&quot;Khách tìm hiểu vị trí,&lt;br/&gt;diện tích, giá thuê\&quot;]\n        C[\&quot;Chọn một hoặc&lt;br/&gt;nhiều văn phòng\&quot;]\n        D{\&quot;Phòng khả dụng,&lt;br/&gt;không trùng lịch?\&quot;}\n        E[\&quot;Nhập thời hạn và&lt;br/&gt;lập hợp đồng dự kiến\&quot;]\n        F{\&quot;Thời hạn thuê&lt;br/&gt;ít nhất 6 tháng?\&quot;}\n        G[\&quot;Ký hợp đồng,&lt;br/&gt;ghi nhận chi tiết phòng\&quot;]\n        H[\&quot;Tính và thu trước&lt;br/&gt;tiền thuê 6 tháng\&quot;]\n        I{\&quot;Đã thanh toán&lt;br/&gt;đủ tiền trả trước?\&quot;}\n\n        A --&gt; B --&gt; C --&gt; D\n        D --&gt;|Có| E --&gt; F\n        D --&gt;|Không| C\n        F --&gt;|Có| G --&gt; H --&gt; I\n        F --&gt;|Không| E\n        I --&gt;|Không| H\n    end\n\n    subgraph P2[\&quot;2. SỬ DỤNG VÀ THANH TOÁN\&quot;]\n        direction TB\n        J[\&quot;Xác nhận hợp đồng,&lt;br/&gt;bàn giao văn phòng\&quot;]\n        K[\&quot;Bắt đầu kỳ sử dụng\&quot;]\n        L{\&quot;Đến kỳ trả tiền&lt;br/&gt;thuê từ tháng 7?\&quot;}\n        M[\&quot;Lập khoản tiền thuê&lt;br/&gt;đến hạn đầu tháng\&quot;]\n        N[\&quot;Thu tiền thuê,&lt;br/&gt;đối soát công nợ\&quot;]\n        O[\&quot;Ghi nhận lượng&lt;br/&gt;dịch vụ phát sinh\&quot;]\n        P{\&quot;Có sử dụng&lt;br/&gt;dịch vụ?\&quot;}\n        Q[\&quot;Cuối tháng lập&lt;br/&gt;hóa đơn dịch vụ\&quot;]\n        R[\&quot;Thu phí dịch vụ,&lt;br/&gt;đối soát công nợ\&quot;]\n\n        J --&gt; K --&gt; L\n        L --&gt;|Có| M --&gt; N --&gt; O\n        L --&gt;|Không| O\n        O --&gt; P\n        P --&gt;|Có| Q --&gt; R\n    end\n\n    subgraph P3[\&quot;3. ĐỐI SOÁT VÀ KẾT THÚC\&quot;]\n        direction TB\n        S{\&quot;Hợp đồng còn&lt;br/&gt;hiệu lực tháng sau?\&quot;}\n        T[\&quot;Chốt công nợ,&lt;br/&gt;hoàn tất chu trình thuê\&quot;]\n        U([Kết thúc])\n        S --&gt;|Không| T --&gt; U\n    end\n\n    I --&gt;|Có| J\n    P --&gt;|Không| S\n    R --&gt; S\n    S --&gt;|Có| K\n\n    classDef action fill:#ffffff,stroke:#222,stroke-width:1px,color:#111\n    classDef decision fill:#ffffff,stroke:#222,stroke-width:1.5px,color:#111\n    classDef terminal fill:#eeeeee,stroke:#222,stroke-width:1.5px,color:#111\n\n    class B,C,E,G,H,J,K,M,N,O,Q,R,T action\n    class D,F,I,L,P,S decision\n    class A,U terminal\n\n    style P1 fill:#f7f7f7,stroke:#888,color:#111\n    style P2 fill:#f7f7f7,stroke:#888,color:#111\n    style P3 fill:#f7f7f7,stroke:#888,color:#111\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VkeQa4vz76w8LxhG3zSX-637">
