        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor QL as Nhân viên quản lý cao ốc\n    participant UI as ManHinhGiaHan\n    participant SV as GiaHanService\n    participant HD as HopDongRepository\n    participant TT as ThanhToanRepository\n    participant DB as CSDL\n    actor KH as Khách thuê\n    participant PH as PhieuGiaHanRepository\n\n    QL-&gt;&gt;UI: Chọn lập phiếu gia hạn\n    UI-&gt;&gt;SV: layThongTinHopDong(maHopDong)\n    activate SV\n\n    SV-&gt;&gt;HD: timHopDong(maHopDong)\n    HD-&gt;&gt;DB: SELECT hợp đồng và chi tiết phòng\n    DB--&gt;&gt;HD: Thông tin hợp đồng\n    HD--&gt;&gt;SV: hopDong\n\n    alt Hợp đồng không hợp lệ\n        SV--&gt;&gt;UI: Thông báo hợp đồng không hợp lệ\n        UI--&gt;&gt;QL: Yêu cầu chọn lại hợp đồng\n    else Hợp đồng hợp lệ\n        SV--&gt;&gt;UI: Hiển thị hợp đồng và danh sách phòng\n        UI--&gt;&gt;QL: Nhập phòng và thời gian gia hạn\n\n        QL-&gt;&gt;UI: Nhập thời gian gia hạn\n        UI-&gt;&gt;SV: kiemTraThoiGianGiaHan()\n\n        alt Thời gian gia hạn vượt giới hạn\n            SV--&gt;&gt;UI: Không quá 1/2 thời gian thuê\n            UI--&gt;&gt;QL: Yêu cầu điều chỉnh thời gian\n        else Thời gian gia hạn hợp lệ\n            SV-&gt;&gt;TT: kiemTraCongNo(maHopDong)\n            TT-&gt;&gt;DB: Truy vấn tiền thuê và phí dịch vụ\n            DB--&gt;&gt;TT: Tổng công nợ\n            TT--&gt;&gt;SV: ketQuaCongNo\n\n            alt Còn nợ tiền thuê hoặc dịch vụ\n                SV--&gt;&gt;UI: Không đủ điều kiện gia hạn\n                UI--&gt;&gt;QL: Yêu cầu thanh toán công nợ\n            else Đã thanh toán đầy đủ\n                SV--&gt;&gt;UI: Đủ điều kiện lập phiếu\n                UI--&gt;&gt;QL: Hiển thị thông tin gia hạn\n\n                QL-&gt;&gt;UI: Xác nhận lập phiếu gia hạn\n                UI-&gt;&gt;SV: lapPhieuGiaHan(duLieu)\n                SV-&gt;&gt;PH: taoPhieuGiaHan(duLieu)\n                PH-&gt;&gt;DB: INSERT phiếu gia hạn\n                DB--&gt;&gt;PH: Mã phiếu gia hạn\n                PH--&gt;&gt;SV: Lập phiếu thành công\n\n                SV--&gt;&gt;UI: Trả kết quả lập phiếu\n                UI--&gt;&gt;QL: Thông báo lập phiếu thành công\n\n                opt Khách thuê nhận xác nhận gia hạn\n                    UI--&gt;&gt;KH: Thông tin phiếu gia hạn\n                end\n            end\n        end\n    end\n    deactivate SV\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VkeQa4vz76w8LxhG3zSX-688">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
