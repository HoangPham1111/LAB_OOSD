        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor KH as Khách hàng\n    participant Frm as FrmDangNhap\n    participant CS as CustomerService\n    participant C as Customer\n    participant DB as SQL Server\n\n    KH-&gt;&gt;Frm: Nhập tên đăng nhập, mật khẩu\n    KH-&gt;&gt;Frm: Nhấn \&quot;Đăng nhập\&quot;\n\n    Frm-&gt;&gt;CS: DangNhap(username, password)\n    CS-&gt;&gt;C: KiemTraThongTin(username, password)\n    C-&gt;&gt;DB: SELECT Customer theo username\n    DB--&gt;&gt;C: Thông tin khách hàng\n    C--&gt;&gt;CS: Kết quả kiểm tra\n\n    alt Thông tin hợp lệ\n        CS-&gt;&gt;C: TaoPhienDangNhap()\n        C--&gt;&gt;CS: Phiên đăng nhập\n        CS--&gt;&gt;Frm: DangNhapThanhCong()\n        Frm--&gt;&gt;KH: Hiển thị giao diện chính\n\n    else Sai tài khoản hoặc mật khẩu\n        CS--&gt;&gt;Frm: DangNhapThatBai()\n        Frm--&gt;&gt;KH: Thông báo \&quot;Sai tài khoản hoặc mật khẩu\&quot;\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v1ThxRbV7BgT7DnbJX8b-192">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
