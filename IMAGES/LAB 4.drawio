        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass FrmSanPham {\n    +HienThiDanhSach()\n    +XemChiTiet()\n    +ThemVaoGio()\n}\n\nclass FrmGioHang {\n    +HienThiGioHang()\n    +CapNhatGioHang()\n    +XoaSanPham()\n}\n\nclass FrmThanhToan {\n    +ChonGiaoHang()\n    +NhapNguoiNhan()\n    +ThanhToan()\n}\n\nclass FrmDangNhap {\n    +DangNhap()\n}\n\nclass CartService {\n    -ThemSanPham()\n    -CapNhatGioHang()\n    -TinhTongTien()\n}\n\nclass CheckoutService {\n    +DatHang()\n    +TinhPhiGiaoHang()\n    +ThanhToan()\n}\n\nclass CustomerService {\n    -DangNhap()\n    -DangKy()\n}\n\nclass ProductService {\n    -LayDanhSach()\n    -LayChiTiet()\n}\n\nclass OnlinePaymentService {\n    +ThanhToan()\n}\n\nclass EmailService {\n    -GuiEmail()\n}\n\nclass Customer {\n    +MaKH: int\n    +HoTen: string\n    +Email: string\n}\n\nclass Cart {\n    +MaGioHang: int\n    +TongTien: decimal\n}\n\nclass CartItem {\n    +SoLuong: int\n    +DonGia: decimal\n}\n\nclass Order {\n    +MaDonHang: int\n    +NgayDat: DateTime\n    +TongTien: decimal\n    +TrangThai: string\n}\n\nclass Payment {\n    +SoTien: decimal\n    +PhuongThuc: string\n    +TrangThai: string\n}\n\nclass Recipient {\n    +HoTen: string\n    +SoDienThoai: string\n    +DiaChi: string\n}\n\nclass DeliveryType {\n    +MaLoai: int\n    +TenLoai: string\n    +PhiGiaoHang: decimal\n}\n\nclass OrderItem {\n    +SoLuong: int\n    +DonGia: decimal\n}\n\nclass Product {\n    +MaSP: string\n    +TenSP: string\n    +DonGia: decimal\n}\n\nclass ProductManagementSystem {\n    -LaySanPham()\n}\n\n%% GIAO DIEN VA SERVICE\nFrmSanPham --&gt; CartService\nFrmSanPham --&gt; ProductService\nFrmGioHang --&gt; CartService\nFrmThanhToan --&gt; CheckoutService\nFrmDangNhap --&gt; CustomerService\n\n%% CUSTOMER\nCustomerService --&gt; Customer\nCustomer --&gt; Order : dat\n\n%% CART SERVICE\nCartService --&gt; Product\nCartService --&gt; Cart\nCartService --&gt; CartItem\n\n%% CART\nCart \&quot;1\&quot; *-- \&quot;n\&quot; CartItem : gom\nCartItem --&gt; Product : san pham\n\n%% CHECKOUT SERVICE\nCheckoutService --&gt; Order\nCheckoutService --&gt; Payment\nCheckoutService --&gt; Recipient\nCheckoutService --&gt; DeliveryType\nCheckoutService --&gt; OnlinePaymentService\nCheckoutService --&gt; EmailService\n\n%% ORDER\nOrder --&gt; Payment : thanh toan\nOrder --&gt; Recipient : nguoi nhan\nOrder --&gt; DeliveryType : giao hang\nOrder \&quot;1\&quot; *-- \&quot;n\&quot; OrderItem : gom\n\n%% PRODUCT\nOrderItem --&gt; Product : san pham\nProductService --&gt; Product\nProductService --&gt; ProductManagementSystem\nProductManagementSystem --&gt; Product : san pham\n\n%% STYLE\nclassDef default fill:#eeeeff,stroke:#9370db,color:#222222,stroke-width:1px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v1ThxRbV7BgT7DnbJX8b-39">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
