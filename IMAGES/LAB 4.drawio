        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass FrmThanhToan {\n    -Frm_Load()\n    -TaiGioHang()\n    -ChonLoaiGiaoHang()\n    -ChonKhuVucGiaoHang()\n    -NhapNguoiNhan()\n    -NhapThongTinThe()\n    -btnDatHang_Click()\n    -btnThanhToan_Click()\n    -btnHuy_Click()\n}\n\nclass CheckoutService {\n    +LayGioHang()\n    +LaySanPham()\n    +KiemTraGioHang()\n    +TinhTienHang()\n    +TinhPhiGiaoHang()\n    +KiemTraTrungThongTin()\n    +KiemTraThe()\n    +ThanhToan()\n    +TaoDonHang()\n    +ThemChiTietDonHang()\n    +GhiNhanThanhToan()\n    +GuiEmailXacNhan()\n}\n\nclass Customer {\n    +MaKH: String\n    +HoTen: String\n    +Username: String\n    +Email: String\n    +SoDienThoai: String\n    --\n    +ThemKhachHang()\n    +LayThongTin()\n}\n\nclass DeliveryType {\n    +MaLoai: String\n    +TenLoai: String\n    +PhiCoBan: Decimal\n    +MucMienPhi: Decimal\n    --\n    +TinhPhi()\n}\n\nclass Order {\n    +MaDonHang: String\n    +NgayDat: DateTime\n    +TongTien: Decimal\n    +PhiGiaoHang: Decimal\n    +TrangThai: String\n    --\n    +ThemDonHang()\n    +LayTrangThai()\n    +CapNhatTrangThai()\n}\n\nclass Cart {\n    +MaGioHang: String\n    +MaKH: String\n    +TongTien: Decimal\n    --\n    +ThemSanPham()\n    +XoaSanPham()\n    +TinhTongTien()\n}\n\nclass Recipient {\n    +MaNguoiNhan: String\n    +HoTen: String\n    +SoDienThoai: String\n    +DiaChi: String\n    --\n    +ThemNguoiNhan()\n    +KiemTraTrungTin()\n}\n\nclass Payment {\n    +MaThanhToan: String\n    +SoTien: Decimal\n    +PhuongThuc: String\n    +TrangThai: String\n    +ThoiGian: DateTime\n    --\n    +ThanhToan()\n    +CapNhatTrangThai()\n}\n\nclass OrderItem {\n    +MaChiTiet: String\n    +MaSP: String\n    +SoLuong: Integer\n    +DonGia: Decimal\n    +ThanhTien: Decimal\n    --\n    +ThemChiTiet()\n    +TinhThanhTien()\n}\n\nclass Product {\n    +MaSP: String\n    +TenSP: String\n    +DonGia: Decimal\n    +MoTa: String\n    --\n    +LaySanPham()\n    +LayDonGia()\n}\n\n%% KET NOI GIAO DIEN VA SERVICE\nFrmThanhToan --&gt; CheckoutService\n\n%% KET NOI CHECKOUT SERVICE\nCheckoutService --&gt; Customer\nCheckoutService --&gt; DeliveryType\nCheckoutService --&gt; Cart\nCheckoutService --&gt; Recipient\nCheckoutService --&gt; Order\nCheckoutService --&gt; Payment\nCheckoutService --&gt; OrderItem\nCheckoutService --&gt; Product\n\n%% QUAN HE NGHIEP VU\nCustomer --&gt; Cart\nCustomer --&gt; Order\nOrder --&gt; Recipient\nOrder --&gt; Payment\nOrder --&gt; OrderItem\nOrderItem --&gt; Product\n\n%% DINH DANG\nclassDef default fill:#eeeeff,stroke:#9370db,color:#222222,stroke-width:1px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v1ThxRbV7BgT7DnbJX8b-240">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;FrmThanhToan&lt;/b&gt;" mermaidId="n:FrmThanhToan" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=45;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#eeeeff;whiteSpace=wrap;fillColor=#eeeeff;strokeColor=#9370db;fontColor=#222222;strokeWidth=1;fontFamily=Recursive;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;FrmThanhToan&lt;/b&gt;" id="v1ThxRbV7BgT7DnbJX8b-241">
