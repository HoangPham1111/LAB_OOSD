        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart LR\n    %% USE CASE DANG NHAP VA DANG KY\n    UC1([\&quot;Đăng nhập\&quot;])\n    UC2([\&quot;Đăng ký&lt;br/&gt;tài khoản\&quot;])\n    UC3([\&quot;Xác thực&lt;br/&gt;khách hàng\&quot;])\n\n    %% USE CASE DAT HANG\n    UC4([\&quot;Chọn loại&lt;br/&gt;giao hàng\&quot;])\n    UC5([\&quot;Nhập thông tin&lt;br/&gt;người nhận\&quot;])\n    UC6([\&quot;Tính phí&lt;br/&gt;giao hàng\&quot;])\n    UC7([\&quot;Thanh toán&lt;br/&gt;bằng thẻ\&quot;])\n    UC8([\&quot;Ghi nhận&lt;br/&gt;đơn hàng\&quot;])\n    UC9([\&quot;Gửi email&lt;br/&gt;xác nhận\&quot;])\n\n    %% USE CASE TRUNG TAM\n    UC10([\&quot;Đặt hàng\&quot;])\n\n    %% QUAN HE EXTEND\n    UC1 -.-&gt;|«extend»| UC3\n    UC2 -.-&gt;|«extend»| UC3\n\n    UC4 -.-&gt;|«extend»| UC10\n    UC5 -.-&gt;|«extend»| UC10\n    UC8 -.-&gt;|«extend»| UC10\n\n    %% QUAN HE INCLUDE\n    UC3 -.-&gt;|«include»| UC10\n    UC6 -.-&gt;|«include»| UC10\n    UC7 -.-&gt;|«include»| UC10\n    UC9 -.-&gt;|«include»| UC10\n\n    %% DINH DANG\n    classDef usecase fill:#f2f0ff,stroke:#9673ff,stroke-width:1.5px,color:#222222\n    class UC1,UC2,UC3,UC4,UC5,UC6,UC7,UC8,UC9,UC10 usecase\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v1ThxRbV7BgT7DnbJX8b-172">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
