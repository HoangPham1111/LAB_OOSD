        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass KhachHang {\n    MaKH : String\n    HoTen : String\n    Email : String\n    SoDienThoai : String\n    DiaChi : String\n}\n\nclass GioHang {\n    MaGioHang : String\n    NgayTao : DateTime\n    TongTien : Decimal\n}\n\nclass ChiTietGioHang {\n    MaChiTiet : String\n    SoLuong : Integer\n    DonGia : Decimal\n    ThanhTien : Decimal\n}\n\nclass SanPham {\n    MaSP : String\n    TenSP : String\n    MoTa : String\n    DonGia : Decimal\n    HinhAnh : String\n}\n\nclass DonHang {\n    MaDonHang : String\n    NgayDat : DateTime\n    TongTien : Decimal\n    TrangThai : String\n}\n\nclass ChiTietDonHang {\n    MaChiTiet : String\n    SoLuong : Integer\n    DonGia : Decimal\n    ThanhTien : Decimal\n}\n\nclass NguoiNhan {\n    MaNguoiNhan : String\n    HoTen : String\n    SoDienThoai : String\n    DiaChi : String\n}\n\nclass LoaiGiaoHang {\n    MaLoai : String\n    TenLoai : String\n    PhiCoBan : Decimal\n}\n\nclass KhuVucGiaoHang {\n    MaKhuVuc : String\n    TenKhuVuc : String\n}\n\nclass ThanhToan {\n    MaThanhToan : String\n    LoaiThe : String\n    SoThe : String\n    SoTien : Decimal\n    TrangThai : String\n}\n\nclass HeThongQuanLySanPham {\n    &lt;&lt;External&gt;&gt;\n    LayDanhSachSanPham()\n    LayChiTietSanPham()\n}\n\nclass DichVuThanhToan {\n    &lt;&lt;External&gt;&gt;\n    KiemTraThe()\n    XuLyThanhToan()\n}\n\nclass DichVuEmail {\n    &lt;&lt;External&gt;&gt;\n    GuiEmailXacNhan()\n}\n\n\nKhachHang \&quot;1\&quot; --&gt; \&quot;1\&quot; GioHang : sở hữu\n\nGioHang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ChiTietGioHang : gồm\n\nChiTietGioHang \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham : sản phẩm\n\nKhachHang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DonHang : đặt\n\nDonHang \&quot;1\&quot; --&gt; \&quot;1..*\&quot; ChiTietDonHang : gồm\n\nChiTietDonHang \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham : sản phẩm\n\nDonHang \&quot;1\&quot; --&gt; \&quot;1\&quot; NguoiNhan : người nhận\n\nDonHang \&quot;0..*\&quot; --&gt; \&quot;1\&quot; LoaiGiaoHang : loại giao hàng\n\nDonHang \&quot;0..*\&quot; --&gt; \&quot;1\&quot; KhuVucGiaoHang : khu vực\n\nDonHang \&quot;1\&quot; --&gt; \&quot;1\&quot; ThanhToan : thanh toán\n\nSanPham ..&gt; HeThongQuanLySanPham : lấy dữ liệu\n\nThanhToan ..&gt; DichVuThanhToan : xử lý\n\nDonHang ..&gt; DichVuEmail : gửi xác nhận&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="__uvx4nd70BtKDkfn33c-276">
