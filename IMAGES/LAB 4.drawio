        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass FrmDangNhap {\n    -Frm_Load()\n    +TaiForm()\n    +NhapTaiKhoan()\n    +NhapMatKhau()\n    +btnDangNhap_Click()\n    +btnDangKy_Click()\n    +btnHuy_Click()\n    +HienThiThongBao()\n}\n\nclass CustomerService {\n    +KiemTraTaiKhoan()\n    +KiemTraMatKhau()\n    +DangNhap()\n    +TaoPhienDangNhap()\n    +LayThongTinKhachHang()\n}\n\nclass Customer {\n    +MaKH: String\n    +HoTen: String\n    +Username: String\n    +Password: String\n    +Email: String\n    +SoDienThoai: String\n    --\n    +KiemTraTaiKhoan()\n    +KiemTraMatKhau()\n    +LayThongTin()\n}\n\nclass Account {\n    -Username: String\n    -Password: String\n    -TrangThai: String\n    --\n    +KiemTraTaiKhoan()\n    +KiemTraMatKhau()\n    +CapNhatTrangThai()\n}\n\nclass LoginSession {\n    +MaPhien: String\n    +MaKH: String\n    +ThoiGianDangNhap: DateTime\n    +TrangThai: String\n    --\n    +TaoPhien()\n    +KetThucPhien()\n}\n\n%% LIEN KET THEO SO DO GOC\nFrmDangNhap --&gt; CustomerService\nCustomerService --&gt; Customer\nCustomerService --&gt; Account\nCustomerService --&gt; LoginSession\nCustomer --&gt; Account\nCustomer --&gt; LoginSession\n\n%% DINH DANG\nclassDef default fill:#eeeeff,stroke:#9370db,color:#222222,stroke-width:1px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v1ThxRbV7BgT7DnbJX8b-357">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
