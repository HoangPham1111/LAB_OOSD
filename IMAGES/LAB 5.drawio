        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    %% BAT DAU\n    START((\&quot;Bắt đầu\&quot;))\n\n    %% TIEP NHAN YEU CAU\n    A[\&quot;Tiếp nhận yêu cầu đăng ký&lt;br/&gt;theo đoàn\&quot;]\n    B[\&quot;Chọn chương trình đăng ký\&quot;]\n    C[\&quot;Nhập thông tin đoàn khách\&quot;]\n\n    %% KIEM TRA THONG TIN\n    D{\&quot;Thông tin đầy đủ và hợp lệ?\&quot;}\n    E[\&quot;Thông báo lỗi và yêu cầu bổ sung\&quot;]\n    F[\&quot;Kiểm tra thông tin khách hàng\&quot;]\n\n    %% KIEM TRA KHACH HANG\n    G{\&quot;Khách hàng hợp lệ?\&quot;}\n    H[\&quot;Yêu cầu cập nhật thông tin&lt;br/&gt;khách hàng\&quot;]\n    I[\&quot;Kiểm tra điều kiện đăng ký&lt;br/&gt;đoàn\&quot;]\n\n    %% KIEM TRA DIEU KIEN\n    J{\&quot;Đáp ứng điều kiện đăng ký?\&quot;}\n    K[\&quot;Thông báo từ chối đăng ký\&quot;]\n\n    %% LAP PHIEU\n    L[\&quot;Tính tổng chi phí đăng ký\&quot;]\n    M[\&quot;Lập phiếu đăng ký theo&lt;br/&gt;đoàn\&quot;]\n    N[\&quot;Lưu phiếu và cập nhật trạng&lt;br/&gt;thái\&quot;]\n    O[\&quot;Thông báo kết quả cho&lt;br/&gt;khách hàng\&quot;]\n\n    %% KET THUC\n    END((\&quot;Kết thúc\&quot;))\n\n    %% LUONG CHINH\n    START --&gt; A\n    A --&gt; B\n    B --&gt; C\n    C --&gt; D\n\n    %% KIEM TRA THONG TIN\n    D --&gt;|Không| E\n    E --&gt; C\n    D --&gt;|Có| F\n\n    %% KIEM TRA KHACH HANG\n    F --&gt; G\n    G --&gt;|Không| H\n    H --&gt; F\n    G --&gt;|Có| I\n\n    %% KIEM TRA DIEU KIEN\n    I --&gt; J\n    J --&gt;|Không| K\n    K --&gt; END\n\n    %% DANG KY THANH CONG\n    J --&gt;|Có| L\n    L --&gt; M\n    M --&gt; N\n    N --&gt; O\n    O --&gt; END\n\n    %% DINH DANG HOAT DONG\n    classDef action fill:#fff9c4,stroke:#ff0000,stroke-width:1.5px,color:#000000\n\n    %% DINH DANG DIEU KIEN\n    classDef decision fill:#ffffff,stroke:#ff0000,stroke-width:1.5px,color:#000000\n\n    %% BAT DAU VA KET THUC\n    classDef terminal fill:#292929,stroke:#292929,stroke-width:1.5px,color:#ffffff\n\n    class A,B,C,E,F,H,I,K,L,M,N,O action\n    class D,G,J decision\n    class START,END terminal\n\n    %% DUONG NOI VA MUI TEN MAU DEN\n    linkStyle default stroke:#000000,stroke-width:1.5px,color:#000000\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="puhWdxF0x4_wXUUVQzlh-25">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
