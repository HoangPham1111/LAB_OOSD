        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    %% BAT DAU\n    START((\&quot;Bắt đầu\&quot;))\n\n    %% TIEP NHAN HO SO\n    A[\&quot;Tiếp nhận hồ&lt;br/&gt;sơ quyết toán&lt;br/&gt;đoàn\&quot;]\n    B[\&quot;Kiểm tra thông&lt;br/&gt;tin đoàn và hồ&lt;br/&gt;sơ\&quot;]\n    C{\&quot;Hồ sơ đầy đủ&lt;br/&gt;và hợp lệ?\&quot;}\n    D[\&quot;Yêu cầu bổ&lt;br/&gt;sung hoặc điều&lt;br/&gt;chỉnh hồ sơ\&quot;]\n\n    %% DOI CHIEU CHI PHI\n    E[\&quot;Đối chiếu chi&lt;br/&gt;phí thực tế\&quot;]\n    F[\&quot;Tổng hợp chi&lt;br/&gt;phí phát sinh\&quot;]\n    G[\&quot;Xác định số&lt;br/&gt;tiền phải&lt;br/&gt;thanh toán\&quot;]\n    H[\&quot;Kiểm tra công&lt;br/&gt;nợ của đoàn\&quot;]\n\n    %% KIEM TRA THANH TOAN\n    I{\&quot;Đã thanh toán&lt;br/&gt;đủ?\&quot;}\n    J{\&quot;Có phát sinh&lt;br/&gt;chi phí cần&lt;br/&gt;điều chỉnh?\&quot;}\n    K[\&quot;Cập nhật chi&lt;br/&gt;phí và tính lại&lt;br/&gt;số tiền\&quot;]\n    L[\&quot;Thông báo số&lt;br/&gt;tiền còn phải&lt;br/&gt;thanh toán\&quot;]\n    M[\&quot;Ghi nhận khoản&lt;br/&gt;thanh toán\&quot;]\n    N{\&quot;Đã thanh toán&lt;br/&gt;đủ sau khi ghi&lt;br/&gt;nhận?\&quot;}\n\n    %% HOAN TAT QUYET TOAN\n    O[\&quot;Xác nhận hoàn&lt;br/&gt;tất thanh toán\&quot;]\n    P[\&quot;Lập và lưu&lt;br/&gt;chứng từ quyết&lt;br/&gt;toán\&quot;]\n    Q[\&quot;Cập nhật trạng&lt;br/&gt;thái công nợ\&quot;]\n\n    %% KET THUC\n    END((\&quot;Kết thúc\&quot;))\n\n    %% LUONG XU LY CHINH\n    START --&gt; A\n    A --&gt; B\n    B --&gt; C\n\n    %% KIEM TRA HO SO\n    C --&gt;|Không| D\n    D --&gt; B\n    C --&gt;|Có| E\n\n    %% TONG HOP CHI PHI\n    E --&gt; F\n    F --&gt; G\n    G --&gt; H\n\n    %% KIEM TRA CONG NO\n    H --&gt; I\n    I --&gt;|Có| O\n    I --&gt;|Không| J\n\n    %% CHI PHI PHAT SINH\n    J --&gt;|Có| K\n    K --&gt; H\n    J --&gt;|Không| L\n\n    %% GHI NHAN THANH TOAN\n    L --&gt; M\n    M --&gt; N\n\n    %% KIEM TRA SAU THANH TOAN\n    N --&gt;|Không| L\n    N --&gt;|Có| O\n\n    %% HOAN TAT\n    O --&gt; P\n    P --&gt; Q\n    Q --&gt; END\n\n    %% DINH DANG HOAT DONG\n    classDef action fill:#fff9c4,stroke:#e53935,stroke-width:1.5px,color:#000000\n\n    %% DINH DANG NUT QUYET DINH\n    classDef decision fill:#ffffff,stroke:#e53935,stroke-width:1.5px,color:#000000\n\n    %% DINH DANG BAT DAU / KET THUC\n    classDef terminal fill:#292929,stroke:#292929,stroke-width:1.5px,color:#ffffff\n\n    class A,B,D,E,F,G,H,K,L,M,O,P,Q action\n    class C,I,J,N decision\n    class START,END terminal\n\n    %% DUONG NOI VA MUI TEN MAU DEN\n    linkStyle default stroke:#000000,stroke-width:1.5px,color:#000000\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="puhWdxF0x4_wXUUVQzlh-62">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
