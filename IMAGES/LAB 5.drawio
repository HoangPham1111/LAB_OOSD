        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor KH as Khách hàng\n    participant UI as Giao diện hệ thống\n    participant DV as Dịch vụ đặt cọc\n    participant DB as Cơ sở dữ liệu\n    participant TT as Cổng thanh toán\n\n    KH-&gt;&gt;UI: Chọn phiếu đăng ký và yêu cầu đặt cọc\n    UI-&gt;&gt;DV: Gửi mã phiếu và số tiền đặt cọc\n    DV-&gt;&gt;DB: Truy vấn thông tin phiếu đăng ký\n    DB--&gt;&gt;DV: Trả về thông tin phiếu\n\n    alt Phiếu đăng ký không hợp lệ\n        DV--&gt;&gt;UI: Thông báo phiếu không hợp lệ\n        UI--&gt;&gt;KH: Yêu cầu kiểm tra lại phiếu\n\n    else Phiếu đăng ký hợp lệ\n        DV-&gt;&gt;DV: Kiểm tra số tiền đặt cọc\n\n        alt Số tiền không hợp lệ\n            DV--&gt;&gt;UI: Thông báo số tiền không hợp lệ\n            UI--&gt;&gt;KH: Yêu cầu nhập lại số tiền\n\n        else Số tiền hợp lệ\n            DV-&gt;&gt;DB: Tạo yêu cầu đặt cọc\n            DB--&gt;&gt;DV: Trả về mã giao dịch\n            DV-&gt;&gt;TT: Khởi tạo thanh toán\n            TT--&gt;&gt;DV: Trả về kết quả thanh toán\n\n            alt Thanh toán thành công\n                DV-&gt;&gt;DB: Lưu giao dịch và cập nhật trạng thái đặt cọc\n                DB--&gt;&gt;DV: Xác nhận cập nhật\n                DV--&gt;&gt;UI: Trả kết quả thành công\n                UI--&gt;&gt;KH: Hiển thị xác nhận đặt cọc\n\n            else Thanh toán thất bại\n                DV-&gt;&gt;DB: Ghi nhận giao dịch thất bại\n                DV--&gt;&gt;UI: Thông báo thanh toán thất bại\n                UI--&gt;&gt;KH: Hướng dẫn thực hiện lại\n            end\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="puhWdxF0x4_wXUUVQzlh-104">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
