        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction LR\n\n    class BenhNhan {\n        +MaBN: String PK\n        +HoTen: String\n        +DiaChi: String\n        +NgaySinh: Date\n        +DienThoai: String\n        +Anh3x4: String\n    }\n    class LePhiNam {\n        +MaLePhi: String PK\n        +MaBN: String FK\n        +NamApDung: Integer\n        +NgayDong: Date\n        +SoTien: Decimal\n        +TrangThai: String\n    }\n    class HoSoBenhAn {\n        +MaHS: String PK\n        +MaBN: String FK UNIQUE\n        +NgayLap: Date\n        +TrangThai: String\n    }\n    class DotDieuTri {\n        +MaDT: String PK\n        +MaHS: String FK\n        +MaNVNhap: String FK\n        +LoaiDot: String\n        +NgayBatDau: DateTime\n        +NgayKetThuc: DateTime\n        +KetQuaTongKet: String\n        +TrangThai: String\n    }\n    class PhieuKham {\n        +MaPK: String PK\n        +MaDT: String FK\n        +MaBS: String FK\n        +MaKhoa: String FK\n        +NgayGioKham: DateTime\n        +TrieuChung: String\n        +ThanNhiet: Decimal\n        +HuyetAp: String\n        +ChanDoan: String\n    }\n    class BacSi {\n        +MaBS: String PK\n        +HoTen: String\n        +ChuyenKhoa: String\n    }\n    class KhoaDieuTri {\n        +MaKhoa: String PK\n        +TenKhoa: String\n    }\n    class XetNghiem {\n        +MaXN: String PK\n        +MaPK: String FK\n        +TenXetNghiem: String\n        +NgayChiDinh: DateTime\n        +NgayThucHien: DateTime\n        +KetQua: String\n        +TrangThai: String\n    }\n    class ToaThuoc {\n        +MaToa: String PK\n        +MaPK: String FK\n        +NgayKe: Date\n        +LoiDan: String\n    }\n    class Thuoc {\n        +MaThuoc: String PK\n        +TenThuoc: String\n        +DonVi: String\n    }\n    class ChiTietToaThuoc {\n        +MaToa: String PK FK\n        +MaThuoc: String PK FK\n        +LieuDung: String\n        +CachDung: String\n        +SoLuong: Decimal\n        +SoNgay: Integer\n    }\n    class LichKhamDinhKy {\n        +MaLich: String PK\n        +MaHS: String FK\n        +MaNVDatLich: String FK\n        +NgayDat: DateTime\n        +NgayGioHen: DateTime\n        +TrangThai: String\n    }\n    class NhanVienCSKH {\n        +MaNV: String PK\n        +HoTen: String\n        +DienThoai: String\n    }\n    class HoaDonVienPhi {\n        +MaHD: String PK\n        +MaDT: String FK UNIQUE\n        +NgayLap: Date\n        +TongTien: Decimal\n        +TrangThai: String\n    }\n    class ThanhToanVienPhi {\n        +MaTT: String PK\n        +MaHD: String FK\n        +NgayThanhToan: DateTime\n        +SoTien: Decimal\n        +PhuongThuc: String\n        +TrangThai: String\n    }\n\n    classDef entity fill:#fffbd2,stroke:#c92649,stroke-width:1px,color:#111111;\n    class BenhNhan entity\n    class LePhiNam entity\n    class HoSoBenhAn entity\n    class DotDieuTri entity\n    class PhieuKham entity\n    class BacSi entity\n    class KhoaDieuTri entity\n    class XetNghiem entity\n    class ToaThuoc entity\n    class Thuoc entity\n    class ChiTietToaThuoc entity\n    class LichKhamDinhKy entity\n    class NhanVienCSKH entity\n    class HoaDonVienPhi entity\n    class ThanhToanVienPhi entity\n\n    BenhNhan \&quot;1\&quot; *-- \&quot;1\&quot; HoSoBenhAn : duoc cap\n    BenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; LePhiNam : dong le phi theo nam\n    HoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; DotDieuTri : luu lich su dieu tri\n    DotDieuTri \&quot;1\&quot; *-- \&quot;1..*\&quot; PhieuKham : gom phieu kham\n    BacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : thuc hien\n    KhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : tiep nhan\n    PhieuKham \&quot;1\&quot; *-- \&quot;0..*\&quot; XetNghiem : co chi dinh\n    PhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc : co toa thuoc neu can\n    ToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc : gom chi tiet\n    Thuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc : duoc ke trong toa\n    HoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; LichKhamDinhKy : co lich hen\n    NhanVienCSKH \&quot;1\&quot; -- \&quot;0..*\&quot; LichKhamDinhKy : tiep nhan dat lich\n    NhanVienCSKH \&quot;1\&quot; -- \&quot;0..*\&quot; DotDieuTri : cap nhat ho so\n    LichKhamDinhKy \&quot;0..1\&quot; -- \&quot;0..1\&quot; DotDieuTri : tao dot khi da kham\n    DotDieuTri \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDonVienPhi : phat sinh hoa don\n    HoaDonVienPhi \&quot;1\&quot; *-- \&quot;0..*\&quot; ThanhToanVienPhi : ghi nhan thanh toan\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9F5ULg2JogezcxPP7mdE-1">
