        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    A((Bắt đầu)) --&gt; B([\&quot;Bác sĩ mở phiếu khám&lt;br/&gt;và chọn Lập toa thuốc\&quot;])\n\n    B --&gt; C([\&quot;Hệ thống kiểm tra MaPK&lt;br/&gt;và trạng thái đợt điều trị\&quot;])\n\n    C --&gt; D{\&quot;Phiếu khám hợp lệ&lt;br/&gt;và đợt điều trị chưa đóng?\&quot;}\n\n    D -- Không --&gt; E([\&quot;Thông báo không thể lập toa\&quot;])\n    E --&gt; Z((Kết thúc))\n\n    D -- Có --&gt; F([\&quot;Kiểm tra toa thuốc&lt;br/&gt;theo mã phiếu khám\&quot;])\n\n    F --&gt; G{\&quot;Phiếu khám đã có toa?\&quot;}\n\n    G -- Có --&gt; H([\&quot;Thông báo toa thuốc&lt;br/&gt;đã tồn tại\&quot;])\n    H --&gt; Z\n\n    G -- Chưa có --&gt; I([\&quot;Bác sĩ xem thông tin khám&lt;br/&gt;và đánh giá tình trạng bệnh\&quot;])\n\n    I --&gt; J{\&quot;Có cần kê toa thuốc?\&quot;}\n\n    J -- Không --&gt; K([\&quot;Không tạo ToaThuoc&lt;br/&gt;tiếp tục quy trình khám bệnh\&quot;])\n    K --&gt; Z\n\n    J -- Có --&gt; L([\&quot;Nhập ngày kê và lời dặn\&quot;])\n\n    L --&gt; M([\&quot;Chọn một thuốc và nhập&lt;br/&gt;liều dùng, cách dùng,&lt;br/&gt;số lượng, số ngày\&quot;])\n\n    M --&gt; N{\&quot;Mã thuốc và thông tin&lt;br/&gt;chi tiết có hợp lệ?\&quot;}\n\n    N -- Không --&gt; O([\&quot;Thông báo lỗi&lt;br/&gt;yêu cầu chỉnh sửa\&quot;])\n    O --&gt; M\n\n    N -- Có --&gt; P{\&quot;Còn thuốc cần kê?\&quot;}\n\n    P -- Có --&gt; M\n\n    P -- Không --&gt; Q([\&quot;Bác sĩ xác nhận lưu toa thuốc\&quot;])\n\n    Q --&gt; R([\&quot;Hệ thống kiểm tra lại phiếu khám&lt;br/&gt;và điều kiện không trùng toa\&quot;])\n\n    R --&gt; S{\&quot;Đủ điều kiện lưu toa?\&quot;}\n\n    S -- Không --&gt; T([\&quot;Thông báo không thể lưu toa\&quot;])\n    T --&gt; Z\n\n    S -- Có --&gt; U([\&quot;Lưu ToaThuoc và ChiTietToaThuoc&lt;br/&gt;trong cùng giao dịch\&quot;])\n\n    U --&gt; V{\&quot;Lưu toàn bộ thành công?\&quot;}\n\n    V -- Không --&gt; W([\&quot;Hoàn tác giao dịch&lt;br/&gt;và thông báo lỗi\&quot;])\n    W --&gt; Z\n\n    V -- Có --&gt; X([\&quot;Hiển thị toa thuốc đã lưu&lt;br/&gt;Bác sĩ hướng dẫn bệnh nhân\&quot;])\n    X --&gt; Z\n\n    classDef action fill:#fff8cc,stroke:#d94d63,stroke-width:1px,color:#222;\n    classDef decision fill:#fff8cc,stroke:#d94d63,stroke-width:1px,color:#222;\n    classDef terminal fill:#111111,stroke:#111111,stroke-width:1px,color:#ffffff;\n\n    class A,Z terminal;\n    class B,C,E,H,I,K,L,M,O,Q,R,T,U,W,X action;\n    class D,G,J,N,P,S,V decision;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9F5ULg2JogezcxPP7mdE-439">
