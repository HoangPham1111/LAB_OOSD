        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nusecase-beta\ndirection LR\n\nactor BenhNhan(\&quot;Bệnh nhân\&quot;)\nactor NVTiepNhan(\&quot;Nhân viên tiếp nhận\&quot;)\nactor BacSi(\&quot;Bác sĩ khám / điều trị\&quot;)\nactor NVXetNghiem(\&quot;Nhân viên xét nghiệm\&quot;)\n\nsystemBoundary PhanRaKhamBenh[\&quot;PHÂN RÃ USE CASE: TIẾP NHẬN VÀ KHÁM BỆNH\&quot;]\n    UCTiepNhanKham(\&quot;Tiếp nhận và đăng ký khám\&quot;)\n    UCDangKyMoi(\&quot;Đăng ký bệnh nhân mới\&quot;)\n    UCDongLePhi(\&quot;Ghi nhận lệ phí năm\&quot;)\n    UCCapHoSo(\&quot;Cấp hồ sơ bệnh án\&quot;)\n    UCKiemTraHoSo(\&quot;Tra cứu / xác minh hồ sơ bệnh án\&quot;)\n    UCGhiPhieuKham(\&quot;Ghi phiếu khám, triệu chứng và sinh hiệu\&quot;)\n    UCChiDinhXN(\&quot;Chỉ định xét nghiệm\&quot;)\n    UCThucHienXN(\&quot;Thực hiện xét nghiệm\&quot;)\n    UCGhiTraKQ(\&quot;Ghi nhận và trả kết quả xét nghiệm\&quot;)\n    UCLapToa(\&quot;Lập toa thuốc\&quot;)\n    UCGhiChiTietToa(\&quot;Ghi chi tiết thuốc và cách dùng\&quot;)\n    UCBanGiaoToa(\&quot;Bàn giao / nhận toa thuốc\&quot;)\nend\n\nBenhNhan --&gt; UCTiepNhanKham\nNVTiepNhan --&gt; UCTiepNhanKham\nBacSi --&gt; UCGhiPhieuKham\nBacSi --&gt; UCChiDinhXN\nBacSi --&gt; UCLapToa\nNVXetNghiem --&gt; UCThucHienXN\nNVXetNghiem --&gt; UCGhiTraKQ\nBenhNhan --&gt; UCBanGiaoToa\n\nUCTiepNhanKham ..&gt; : include UCKiemTraHoSo\nUCTiepNhanKham ..&gt; : include UCGhiPhieuKham\n\nUCDangKyMoi ..&gt; : extend UCTiepNhanKham\nUCDangKyMoi ..&gt; : include UCDongLePhi\nUCDangKyMoi ..&gt; : include UCCapHoSo\n\nUCChiDinhXN ..&gt; : extend UCGhiPhieuKham\nUCChiDinhXN ..&gt; : include UCThucHienXN\nUCThucHienXN ..&gt; : include UCGhiTraKQ\n\nUCLapToa ..&gt; : extend UCGhiPhieuKham\nUCLapToa ..&gt; : include UCGhiChiTietToa\nUCLapToa ..&gt; : include UCBanGiaoToa\n\nclassDef actorStyle fill:#ffffff,stroke:#c92649,stroke-width:1.4px,color:#111111\nclassDef useCaseStyle fill:#fffde8,stroke:#c92649,stroke-width:1.2px,color:#111111\nclass BenhNhan,NVTiepNhan,BacSi,NVXetNghiem actorStyle\nclass UCTiepNhanKham,UCDangKyMoi,UCDongLePhi,UCCapHoSo,UCKiemTraHoSo,UCGhiPhieuKham,UCChiDinhXN,UCThucHienXN,UCGhiTraKQ,UCLapToa,UCGhiChiTietToa,UCBanGiaoToa useCaseStyle\nstyle PhanRaKhamBenh fill:#fffbd2,stroke:#c92649,stroke-width:2px,color:#111111\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9F5ULg2JogezcxPP7mdE-267">
