<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Sua Data Source cho SQL Server/SQL Express dang dung neu khong co LocalDB. -->
    <add name="QLNS_DongA" connectionString="Data Source=DGESVRJ;Initial Catalog=QLNS_DongA;Integrated Security=True;Connect Timeout=15;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- CHI LA GIA TRI MINH HOA. Can thay bang chuan gio duoc phe duyet cua cong ty. -->
    <add key="GioChuanThang" value="208" />
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
