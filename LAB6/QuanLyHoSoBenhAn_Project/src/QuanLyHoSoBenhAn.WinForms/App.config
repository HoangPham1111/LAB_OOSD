<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Sửa Data Source theo SQL Server trên máy bạn, ví dụ .\SQLEXPRESS hoặc (localdb)\MSSQLLocalDB -->
    <add name="QuanLyHoSoBenhAn" connectionString="Data Source=DGESVRJ;Initial Catalog=QuanLyHoSoBenhAn;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
